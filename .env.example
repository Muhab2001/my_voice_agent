# Local development values only. Replace both secrets before exposing the API.
APP_PASSWORD=change-this-development-password
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://voice:voice@127.0.0.1:5432/voice
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=3000
DATABASE_MAX_LIFETIME_SECONDS=0
ALLOWED_ORIGIN=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
# Optional for a deployed web app; local Vite uses its same-origin API proxy.
# VITE_API_BASE_URL=https://api.example.com

# Server only; never place in a VITE_ variable.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
